{
  "functions": {
    "api/index.py": { "memory": 1024, "maxDuration": 60 },
    "api/pdf.js": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/api/index" }
  ]
}
